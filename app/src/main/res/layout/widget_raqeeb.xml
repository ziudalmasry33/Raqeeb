<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:background="#062E22" android:id="@+id/widgetRoot" android:layout_height="match_parent" android:layout_width="match_parent" android:orientation="vertical" android:padding="14dp" xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout android:gravity="center_vertical" android:layout_height="wrap_content" android:layout_width="match_parent" android:orientation="horizontal">

        <TextView android:layout_height="wrap_content" android:layout_weight="1" android:layout_width="0dp" android:text="🛡️ رقيب | إشراقة إيمانية" android:textColor="#D4AF37" android:textSize="12sp" android:textStyle="bold"/>

        <TextView android:id="@+id/widgetRefreshBtn" android:layout_height="wrap_content" android:layout_width="wrap_content" android:paddingHorizontal="8dp" android:paddingVertical="2dp" android:text="↻ تحديث" android:textColor="#D4AF37" android:textSize="11sp" android:textStyle="bold"/>
    </LinearLayout>

    <TextView android:id="@+id/widgetZikrText" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_width="match_parent" android:text="﴿ أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ ﴾" android:textColor="#F4F6F5" android:textSize="14sp" android:textStyle="bold"/>

    <TextView android:id="@+id/widgetZikrSource" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_width="match_parent" android:text="سورة الرعد - آية 28" android:textColor="#9FB3AD" android:textSize="11sp"/>
</LinearLayout>
